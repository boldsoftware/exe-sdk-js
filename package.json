{
  "name": "@exedev/sdk",
  "version": "0.4.1",
  "description": "Official JavaScript/TypeScript SDK for the exe.dev API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test test/*.test.js",
    "sync-commands": "sh scripts/sync-commands.sh",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "exe.dev",
    "exedev",
    "cloud",
    "vm",
    "api",
    "sdk"
  ],
  "author": "exe.dev",
  "license": "MIT",
  "homepage": "https://exe.dev/docs/https-api",
  "bugs": {
    "url": "https://github.com/boldsoftware/exe-sdk-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boldsoftware/exe-sdk-js.git"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18"
  }
}
